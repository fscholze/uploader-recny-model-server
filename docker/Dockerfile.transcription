################ build container for python apps
FROM nvidia/cuda:13.1.1-cudnn-devel-ubuntu24.04 AS python_builder

WORKDIR /opt/venv/

RUN apt update && apt install -y python3-venv python3-dev && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv/ctranslate2
COPY docker/requirements_ctranslate2.txt /opt/

RUN cd /opt/venv/ctranslate2 && /bin/bash -c 'source bin/activate && pip install -r /opt/requirements_ctranslate2.txt'

RUN python3 -m venv /opt/venv/forcealign
COPY docker/requirements_forcealign.txt /opt/

RUN cd /opt/venv/forcealign && /bin/bash -c 'source bin/activate && pip3 install -r /opt/requirements_forcealign.txt'

COPY src/scripts/align_wav2vec2.py          /opt/venv/forcealign/
COPY src/scripts/translate_srt_sotra_lsf.py /opt/venv/forcealign/
COPY src/scripts/log2srt.py                 /opt/venv/forcealign/
COPY src/scripts/log2txt.py                 /opt/venv/forcealign/

################ build container for node
FROM node:24 AS node_builder
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY tsconfig.json ./
ADD src/ ./src/
RUN npm run build
# RUN ls -l

################ runtime container
FROM nvidia/cuda:13.1.1-runtime-ubuntu24.04

LABEL com.nvidia.cuda.version="12.6"
LABEL license="Includes NVIDIA CUDA redistributables subject to NVIDIA EULA"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt update && apt install -y python3 ffmpeg sox nodejs npm libhunspell-1.7-0 libresample1 && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/app/src

# whisper.cpp / cmdline übernehmen
COPY --chown=1000:1000 --from=ghcr.io/zalozbadev/docker_vosk-cmdline:unify_recognizers /opt/build/whisper.cpp                                 /opt/whisper.cpp
COPY --chown=1000:1000 --from=ghcr.io/zalozbadev/docker_vosk-cmdline:unify_recognizers /opt/build/common/cmdline/whisper_out                  /opt/whisper_out
COPY --chown=1000:1000 --from=ghcr.io/zalozbadev/docker_vosk-cmdline:unify_recognizers /opt/build/common/cmdline/recikts_out                  /opt/recikts_out
COPY --chown=1000:1000 --from=ghcr.io/zalozbadev/docker_vosk-cmdline:unify_recognizers /opt/build/common/cmdline/onnxruntime-linux-x64-1.12.1 /opt/onnxruntime-linux-x64-1.12.1

# python apps übernehmen
COPY --chown=1000:1000 --from=python_builder /opt/venv /opt/venv

# node backend
COPY --chown=1000:1000 package*.json ./
RUN npm ci --omit=dev

COPY --chown=1000:1000 --from=node_builder /app/dist ./dist

RUN mkdir -p uploads proprietary whisper logs && chown 1000:1000 uploads proprietary whisper logs

RUN mkdir -p src/scripts && chown -R 1000:1000 src/
COPY --chown=1000:1000 src/scripts/create_transcript.sh  src/scripts/transcript_whisper.sh \
     src/scripts/create_forcealign.sh src/scripts/forcealign.sh src/scripts/align_wav2vec2.py \
     src/scripts/log2srt.py src/scripts/log2txt.py \
     src/scripts/translate_srt.sh src/scripts/translate_srt_sotra_lsf.py \
src/scripts

USER 1000

ENV NODE_ENV=production
ENV SERVER_MODE=TRANSCRIPT

CMD ["node", "dist/index.js"]
